# BISync Environment Configuration Template
# Copy this file to .env.local for local development

# Local LLM Inference (llama-server / Gemma)
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=gemma-local
LLM_TIMEOUT=180.0

# Backend Service
HOST=127.0.0.1
PORT=8000

# Security (Set a secure secret in production)
JWT_SECRET=replace_with_a_secure_random_key_in_production
